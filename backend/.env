PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=nexice
# Le schéma est géré par les migrations (src/migrations). DB_SYNC doit rester false.
DB_SYNC=false
# true : applique les migrations en attente au démarrage de l'API (pratique avec Docker)
DB_MIGRATIONS_RUN=true
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire
CORS_ORIGIN=
TVA_RATE=0.1925
ADMIN_EMAIL=admin@nexice.app
# Entre guillemets : sans cela, le "#" est lu comme un commentaire et le mot de passe est tronqué
ADMIN_PASSWORD="Admin#12345"
# Assistant IA (optionnel)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Pages légales publiques (/api/legal/privacy et /api/legal/delete-account) exigées par Google Play
LEGAL_COMPANY=Nom de votre structure
LEGAL_EMAIL=contact@votredomaine.com
